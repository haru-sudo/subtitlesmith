# =====================================================================
# nginx + PHP-FPM で動かす場合の設定例（Apache の .htaccess と同じ制限を掛ける）
#
#   - ドメイン直下に置く例です。サブディレクトリに置く場合は location の先頭に
#     /subtitlesmith などを付け、config.php の base_path も合わせてください。
#   - root はリポジトリを置いたディレクトリ、fastcgi_pass は PHP-FPM のソケットに合わせて変更。
#   - アップロード上限は .user.ini ではなく client_max_body_size と php.ini で設定します。
# =====================================================================

server {
    listen 80;
    server_name example.com;

    root /var/www/subtitlesmith;
    index index.php;

    client_max_body_size 50g;
    autoindex off;

    # 機微ディレクトリ・ファイルへの直アクセスを遮断
    location ~ ^/(config|src|templates|python|samples|deploy|logs|tools|docs|\.git|\.github)(/|$) { return 403; }
    location ~ ^/(worker\.php|runner\.php|schema\.sql|composer\.json|README\.md|\.user\.ini)$ { return 403; }
    location ~ \.(sqlite|sqlite-wal|sqlite-shm|db|db-wal|db-shm|db-journal|env|log|bak|ini)$ { return 403; }

    # 元動画は Web サーバーから直接配信（ファイル名を知っている人は再生できる。編集画面のプレーヤーが使う）
    location ^~ /storage/videos/  { try_files $uri =404; }
    # それ以外の storage（書き出した MP4 を含む）は遮断。ダウンロードはログイン済みのときだけ PHP 経由で行う
    location ^~ /storage/ { return 403; }

    # それ以外はフロントコントローラへ
    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 1800;
    }

    # index.php 以外の PHP は実行しない
    location ~ \.php$ { return 403; }
}
